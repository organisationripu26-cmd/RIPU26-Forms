# Copiez ces noms dans Netlify > Site configuration > Environment variables.
# NE JAMAIS committer un vrai .env (voir .gitignore).

# =====================================================================
# CONFIGURATION MULTI-BASES (3 BASES DISTINCTES - RECOMMANDÉ)
# =====================================================================
# Base 1 : Confirmation de participation
SUPABASE_URL_FORM1=https://xxxx1.supabase.co
SUPABASE_SERVICE_KEY_FORM1=eyJ...

# Base 2 : Informations d'arrivée
SUPABASE_URL_FORM2=https://xxxx2.supabase.co
SUPABASE_SERVICE_KEY_FORM2=eyJ...

# Base 3 : Inscription à l'excursion
SUPABASE_URL_FORM3=https://xxxx3.supabase.co
SUPABASE_SERVICE_KEY_FORM3=eyJ...

# =====================================================================
# CONFIGURATION SIMPLE (UNE BASE UNIQUE POUR LES 3 FORMULAIRES - OPTION)
# =====================================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Domaine(s) autorisé(s) à appeler l'API, séparés par des virgules (optionnel mais conseillé)
ALLOWED_ORIGIN=https://ripu26-forms.netlify.app

# --- Notifications e-mail (optionnel) : https://resend.com ---
RESEND_API_KEY=
MAIL_FROM=RIPU26 <inscription@votre-domaine.tn>
ORG_NOTIFY_EMAIL=ripusousse@gmail.com
# NOTIFY_ORG=off          # couper l'e-mail à chaque saisie (garder le résumé quotidien)
# NOTIFY_PARTICIPANT=off  # couper l'e-mail de confirmation aux participants

# --- Export / administration ---
# Jeton long et aléatoire (≥ 32 caractères) : openssl rand -hex 24
ADMIN_TOKEN=
